#!/bin/sh
# ================================================================
# files/etc/uci-defaults/99-20-service-defaults
#
# 【作用】按需求修正各服务的出厂默认状态：
#   1. Mwan3 多线负载均衡默认禁用（单 WAN 场景无需启用，
#      修复状态页默认显示"已配置"的问题，需要时可在
#      LuCI「网络 → 多线多拨」中自行开启）；
#   2. EasyTier 默认启用核心与 Web 控制台（修复状态总览
#      一直显示"正在收集数据"、无核心无 Web 页面的问题）；
#   3. 防火墙默认关闭软件/硬件流量分载 —— 分载流量走内核
#      快速路径，绕过 conntrack 计数，nlbwmon（带宽监控）
#      将统计不到数据，二者互斥；BBR 加速不受影响，默认开启
#      （见 files/etc/config/turboacc）。
#
#【运行机制】/etc/uci-defaults/ 下的脚本在系统首次启动时自动
#   执行一次，执行成功（exit 0）后由系统自动删除。
# ================================================================

# -------- 1. Mwan3：默认关闭 --------
# wan 接口的 mwan3 管理开关设为 0 后，mwan3 不创建任何策略路由
# 与防火墙规则，状态页显示未启用
uci -q set mwan3.wan.enabled='0'
uci -q commit mwan3

# -------- 2. EasyTier：默认启用核心 + Web 控制台 --------
# web_html_port 同时供 LuCI「EasyTier Web」标签页生成访问地址，
# 以及 init 脚本传递 -l 参数给 easytier-web（不设置该端口时
# easytier-web 会以 --no-web 启动，Web 页面将不可用）；
# web_db_path 将 Web 控制台数据库持久化到 /etc/easytier/，
# 避免重启后控制台中已添加的设备配置丢失
uci -q set easytier.@easytier[0].enabled='1'
uci -q set easytier.@easytier[0].web_enabled='1'
uci -q set easytier.@easytier[0].web_html_port='11211'
uci -q set easytier.@easytier[0].web_db_path='/etc/easytier/et.db'
uci -q commit easytier

# -------- 3. 防火墙：默认关闭流量分载（保 nlbwmon 统计） --------
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall
# 固件内置默认值为 1，fw4 已按 1 加载过规则，需 reload 生效
/etc/init.d/firewall reload >"/dev/null" 2>&1 || true

exit 0
