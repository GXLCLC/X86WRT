#!/bin/sh
# ================================================================
# files/etc/uci-defaults/99-11-root-password
#
#【作用】首次启动时设置 root 默认登录密码为 password，
#   与 Release 页面公布的后台登录信息保持一致。
#
#【保护逻辑】仅当 /etc/shadow 中 root 密码字段为空（未设置密码）时
#   才写入默认密码；用户后期修改过的密码不会被覆盖，
#   sysupgrade 升级后也能保留用户的密码。
#
#【说明】busybox 的 passwd 支持从标准输入（非交互）读取两次新密码。
# ================================================================

# 提取 root 密码字段（/etc/shadow 第 1 行格式: root:HASH:...）
hash="$(awk -F: '$1 == "root" { print $2 }' /etc/shadow 2>/dev/null || true)"

# 密码字段为空 → 未设置密码，写入默认密码 password
if [ -z "$hash" ]; then
	printf '%s\n%s\n' 'password' 'password' | passwd root >/dev/null 2>&1 || true
fi

exit 0
