# ==============================================================
# ImmortalWrt X86_64 云编译配置（Ubuntu 22.04 + GitHub Actions）
#
# 使用说明：
#   1. 本文件为"增量式"配置，工作流中会执行 `make defconfig` 自动补全；
#   2. 增加插件：添加一行 CONFIG_PACKAGE_<插件包名>=y（插件需存在于
#      ImmortalWrt feeds 或 scripts/packages.sh 拉取的第三方目录中）；
#   3. 删除插件：将该行改为 # CONFIG_PACKAGE_<插件包名> is not set；
#   4. 注意：kmod-xxx 等依赖会自动解析，无需手动列出。
# ==============================================================

# ---------------------------------------------------------------
# 目标平台：X86_64 通用设备（仅编译 64 位固件）
# ---------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------------------------------------------------------
# 镜像格式：仅 squashfs combined（BIOS+UEFI）IMG 镜像
# 不生成 ISO / QCOW2 / VDI / VMDK / VHDX / ONIE 等其他格式
# ---------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# CONFIG_ONIE_INSTALLER_IMAGES is not set
# CONFIG_TARGET_IMAGES_GZIP is not set

# ---------------------------------------------------------------
# 分区大小（MB）
#   内核分区 32MB；根分区先按 1024MB 生成，
#   编译完成后由 scripts/post-build.sh 将 rootfs_data(/overlay)
#   可写空间精确扩容至 2048MB
# ---------------------------------------------------------------
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---------------------------------------------------------------
# 编译加速：启用 ccache（缓存目录 ~/immortalwrt/.ccache）
# ---------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------------------------------------------------------------
# LuCI 界面与中文语言
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
# 第三方 LuCI 插件普遍需要的 lua 兼容层
CONFIG_PACKAGE_luci-compat=y
# ImmortalWrt 默认优化（默认开启 packet_steering 等）
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# ---------------------------------------------------------------
# 主题：Argon（设为系统默认主题，见 files/etc/uci-defaults/）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------------------------------------------------------------
# 代理插件：仅集成 OpenClash 这一个代理插件，不添加其他代理类插件
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y

# ---------------------------------------------------------------
# SmartDNS（ImmortalWrt 源码自带）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-smartdns_INCLUDE_WebUI=y

# ---------------------------------------------------------------
# DDNSTO 远程控制（第三方：linkease/nas-packages-luci + nas-packages，
# 由 scripts/packages.sh 自动拉取 luci 前端与后端程序包）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ddnsto=y

# ---------------------------------------------------------------
# AdGuard Home 去广告（ImmortalWrt 源码自带）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------------------------------------------------------------
# OAF 应用过滤（ImmortalWrt 源码自带，包名为 luci-app-appfilter，
# 自动依赖 appfilter 后端与 kmod-oaf 内核模块，即 luci-app-oaf）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-appfilter=y

# ---------------------------------------------------------------
# TurboAcc 加速（第三方：kenzok8/small-package，
# 由 scripts/packages.sh 自动拉取）
#   软件流量分载(Software Flow Offloading) + BBR 拥塞控制算法
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y

# ---------------------------------------------------------------
# Mwan3 多线多拨/负载均衡（ImmortalWrt 源码自带）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-mwan3=y

# ---------------------------------------------------------------
# 带宽监控 nlbwmon（ImmortalWrt 源码自带）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ---------------------------------------------------------------
# EasyTier 内网穿透（第三方：EasyTier/luci-app-easytier，
# 由 scripts/packages.sh 自动拉取 luci 前端与 easytier 核心）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y

# ---------------------------------------------------------------
# DNS：使用完整版 dnsmasq-full（OpenClash / TurboAcc / SmartDNS 依赖）
# ---------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ---------------------------------------------------------------
# USB 驱动：USB2/USB3 主机控制器 + OHCI/UHCI + 存储与 USB 网卡
#（x86 默认已含 usb-hid、asix、ax88179、rtl8150/rtl8152 等 USB 网卡）
# ---------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

# ---------------------------------------------------------------
# 有线网卡驱动：英特尔、瑞昱系列
#（x86_64 默认已内置：e1000/e1000e/igb/igc/ixgbe/i40e/ixgbevf 等
#   英特尔系列，以及 8139too/8139cp/r8101/r8125/r8126/r8168 等
#   瑞昱系列；此处补充内核原生 r8169 覆盖更多 8168/8111 型号）
# ---------------------------------------------------------------
CONFIG_PACKAGE_kmod-r8169=y
